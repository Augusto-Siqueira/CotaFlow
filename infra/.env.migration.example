# Copie para infra/.env.migration (fica fora do git) e preencha NO SEU COMPUTADOR.
# NUNCA cole estes valores em chat, e-mail ou no código.

# Supabase (origem) -> Project Settings > Database > Connection string.
# Use o "Session pooler" (porta 5432): o endereço direto do plano gratuito é
# só IPv6 e costuma falhar no Docker do Windows.
# Formato: postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Supabase -> Project Settings > API (para baixar as fotos).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
